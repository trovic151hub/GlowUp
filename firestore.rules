rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSignedInOrderOwner() {
      return request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;
    }

    function isGuestOrderOwner() {
      return resource.data.guestId is string &&
        request.resource.data.guestId == resource.data.guestId;
    }

    function canReadGuestOrder() {
      return resource.data.guestId is string;
    }

    function isReceiptEmailOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptEmail']) &&
        request.resource.data.receiptEmail is map &&
        request.resource.data.receiptEmail.status in ['pending', 'sent', 'failed'];
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /heroSliders/{slideId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /guestCarts/{guestId} {
      allow read, delete: if
        guestId.matches('^guest_.*') &&
        (isAdmin() || resource.data.guestId == guestId);

      allow create, update: if
        guestId.matches('^guest_.*') &&
        (
          isAdmin() ||
          request.resource.data.guestId == guestId
        );
    }

    match /orders/{orderId} {
      allow create: if true;
      allow update, delete: if isAdmin();
      allow update: if isReceiptEmailOnlyUpdate() &&
        (isSignedInOrderOwner() || isGuestOrderOwner());
      allow read: if isAdmin();
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read: if canReadGuestOrder();
    }

    match /users/{uid} {
      allow read, write: if isAdmin();
      allow read, create, update: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
